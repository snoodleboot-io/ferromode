LIBDIR = ../target/release
STATLIB = $(LIBDIR)/libferromodeR.a
PKG_LIBS = -L$(LIBDIR) -lferromodeR -lpthread -ldl

all: $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --lib --release \
		--manifest-path=../Cargo.toml \
		--target-dir=../target

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)
